#include <stdio.h>

void print(int n, int a[]);

int main() {
    int n, a[50], i;
    printf("enter number of elements\n");
    scanf("%d", &n);
    printf("enter elements into array\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    printf("array in reverse order is:\n");
    print(n, a);
    return 0;
}

void print(int n, int a[]) {
    if (n == 0) {
        return;
    }
    printf("%d\n", a[n - 1]);
    print(n - 1, a);
}
